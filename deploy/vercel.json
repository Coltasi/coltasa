{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/score", "destination": "/sales-engine-score", "permanent": true }
  ],
  "headers": [
    { "source": "/report", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/report.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/map", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/map.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(llms.txt|llms-full.txt)", "headers": [
      { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] },
    { "source": "/feed.xml", "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/_ds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
